# ==========================================
# CrowdFund Platform - Environment Variables
# Copy to .env or set in container / cloud environment
# ==========================================

# Server Port
PORT=8080

# Database Configuration (MySQL Production or Custom Postgres/H2)
DB_URL=jdbc:mysql://localhost:3306/crowdfund?useSSL=true&serverTimezone=UTC
DB_USERNAME=crowdfund_app
DB_PASSWORD=YourStrongDatabasePassword123!
H2_CONSOLE_ENABLED=false

# Root Administrator Setup
ADMIN_EMAIL=admin@crowdfund.com
ADMIN_PASSWORD=SuperSecretAdminPassword2026!

# Payment Gateway & Webhook Secrets
PAYMENT_WEBHOOK_SECRET=sec_live_replace_with_actual_32_byte_hmac_secret
PAYMENT_API_KEY=sk_live_replace_with_actual_payment_provider_key

# Security & Data Seeding
SEED_DEMO_DATA=false
UPLOAD_DIR=./uploads
